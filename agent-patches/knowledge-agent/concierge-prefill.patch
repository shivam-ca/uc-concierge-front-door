--- a/web/chat/index.html
+++ b/web/chat/index.html
@@ -590,6 +590,35 @@ function track(id, started) {
     await loadList(); if (CURID === id) await loadCurrent(true);
   });
 }
+// UC Concierge, the suite's front door, opens /chat?q=<request>&from=concierge (canonical copy of these two functions:
+// uc-concierge-front-door/agent-patches/prefill/concierge-prefill.js).
+// --- UC Concierge hand-off
+function takeConciergeRequest(href) {
+  const url = new URL(href);
+  if (url.searchParams.get("from") !== "concierge") return null;
+  const q = (url.searchParams.get("q") || "").trim();
+  if (!q) return null;
+  url.searchParams.delete("q");
+  url.searchParams.delete("from");
+  return { q, cleanUrl: url.pathname + url.search + url.hash };
+}
+function fitRequest(q, maxLength) {
+  if (!maxLength || q.length <= maxLength) return { text: q, cut: false };
+  return { text: q.slice(0, maxLength), cut: true };
+}
+// --- end UC Concierge hand-off
+// Asks the handed-over question once, always as a new chat; the address loses q/from first, so a reload never asks again.
+function conciergeHandoff() {
+  const handoff = takeConciergeRequest(location.href);
+  if (!handoff) return;
+  history.replaceState(null, "", handoff.cleanUrl);
+  if (CURID) { CURID = ""; CUR = null; history.replaceState(null, "", location.pathname); renderThread(); renderSide(); }
+  const ta = $("#msgtext");
+  const fit = fitRequest(handoff.q, Number(ta?.getAttribute("maxlength")) || 4000);
+  toast(fit.cut ? "From UC Concierge. Your question was shortened to fit; check it, then send." : "From UC Concierge");
+  if (fit.cut) { if (ta) { ta.value = fit.text; ta.focus(); } return; }
+  send(fit.text);
+}
 async function send(textArg) {
   const ta = $("#msgtext"), text = (textArg ?? ta?.value ?? "").trim(); if (!text) return;
   if (ta) { ta.value = ""; ta.style.height = ""; }
@@ -754,6 +783,7 @@ ROLE = "user";
   applyLayout();
   await loadStatus(); await loadList(); applyRole();
   if (CURID) { $("#app").classList.add("reading"); await loadCurrent(false); } else { renderThread(); renderSide(); }
+  conciergeHandoff();
 })();
 </script>
 </body>
